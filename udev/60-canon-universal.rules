# udev rules for Canon Universal Linux Driver
# This covers basic access to Canon printers (Vendor ID 04a9)
# specifically for libusb-1.0 backend operations.

# PIXMA G Series
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="1821", MODE="0664", GROUP="lp"
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="1822", MODE="0664", GROUP="lp"
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="1823", MODE="0664", GROUP="lp"
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="1824", MODE="0664", GROUP="lp"

# PIXMA E Series
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="179e", MODE="0664", GROUP="lp"
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="17a1", MODE="0664", GROUP="lp"
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="182b", MODE="0664", GROUP="lp"

# PIXMA iP Series
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="1774", MODE="0664", GROUP="lp"
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="1762", MODE="0664", GROUP="lp"

# PIXMA MG Series
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="176d", MODE="0664", GROUP="lp"
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="179a", MODE="0664", GROUP="lp"

# PIXMA TR/TS Series
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="1855", MODE="0664", GROUP="lp"
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="186b", MODE="0664", GROUP="lp"

# imageCLASS Series
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="2759", MODE="0664", GROUP="lp"
ATTRS{idVendor}=="04a9", ATTRS{idProduct}=="27b0", MODE="0664", GROUP="lp"

# Generic fallback for Canon Printers (04a9) class 7 (printer)
SUBSYSTEM=="usb", ATTRS{idVendor}=="04a9", ATTRS{bInterfaceClass}=="07", MODE="0664", GROUP="lp"
