#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Canon Photo Print: lay out and print photos (4x6, 5x7, borderless, several per sheet).

    canon-photo-print [PHOTO...]

Reads the paper sizes and paper types of the chosen printer from CUPS,
builds the sheets as a PDF at the exact page size, and prints with
photo-friendly settings (photo paper, High quality, borderless where the
printer supports it).  Needs PySide6.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request
from functools import lru_cache

try:
    import numpy as np          # colour adjustments; optional
except ImportError:
    np = None

try:
    from PySide6.QtCore import QMarginsF, QPointF, QRectF, QSize, QSizeF, Qt, QTimer
    from PySide6.QtGui import (QColor, QFont, QIcon, QImage, QImageReader, QPageLayout, QPageSize, QPainter,
                               QPdfWriter, QPen, QPixmap)
    from PySide6.QtWidgets import (QApplication, QCheckBox, QComboBox, QFileDialog, QFormLayout, QHBoxLayout,
                                   QLabel, QListWidget, QListWidgetItem, QMainWindow, QMessageBox,
                                   QPushButton, QSlider, QSpinBox, QVBoxLayout, QWidget, QGroupBox, QDialog,
                                   QDoubleSpinBox, QDialogButtonBox)
except ImportError:
    sys.exit('canon-photo-print needs PySide6 (Arch: sudo pacman -S pyside6, Debian: python3-pyside6.*)')

IMAGE_FILTER = 'Photos (*.jpg *.jpeg *.png *.tif *.tiff *.webp *.bmp *.gif *.heic)'
LAYOUTS = [(1, 1, 1), (2, 1, 2), (4, 2, 2), (6, 2, 3), (9, 3, 3)]   # count, columns, rows
GAP = 6.0          # points between photos on multi-photo sheets
PHOTO_HINT = ('photo', 'glossy', 'luster', 'matte', 'semigloss', 'pro', 'plus')


# ---- printer information ----

def printers():
    out = subprocess.run(['lpstat', '-e'], capture_output=True, text=True).stdout.split()
    d = subprocess.run(['lpstat', '-d'], capture_output=True, text=True).stdout
    default = d.split(':', 1)[1].strip() if ':' in d else None
    return out, default


def printer_ppd(queue):
    """Paper sizes and types from the queue's PPD, which CUPS serves locally."""
    try:
        if os.path.isfile(queue):          # a PPD file (tests, offline use)
            text = open(queue, encoding='latin-1').read()
        else:
            url = f'http://localhost:631/printers/{urllib.parse.quote(queue)}.ppd'
            text = urllib.request.urlopen(url, timeout=5).read().decode('latin-1')
    except OSError:
        return None
    sizes, area, media = {}, {}, []
    printarea, overhang = {}, {}
    res = 600
    cover = False
    default_media = None
    for line in text.splitlines():
        if re.match(r'\*[a-z]{2}(_[A-Z]{2})?\.', line):
            continue
        m = re.match(r'\*PageSize ([^/:]+)/([^:]+): ".*PageSize\s*\[\s*([\d.]+)\s+([\d.]+)\s*\]', line)
        if m:
            sizes[m.group(1)] = {'name': m.group(1), 'label': m.group(2).strip(),
                                 'w': float(m.group(3)), 'h': float(m.group(4))}
        m = re.match(r'\*ImageableArea ([^:]+): "([^"]+)"', line)
        if m:
            area[m.group(1)] = [float(v) for v in m.group(2).split()]
        m = re.match(r'\*MediaType ([^/:]+)/([^:]+):', line)
        if m:
            media.append((m.group(1), m.group(2).strip()))
        m = re.match(r'\*DefaultMediaType: (\S+)', line)
        if m:
            default_media = m.group(1)
        m = re.match(r'\*cnivecPaperSize ([^:]+): "\S+ (\d+) (\d+)', line)
        if m:
            printarea[m.group(1)] = (int(m.group(2)), int(m.group(3)))
        m = re.match(r'\*cnivecOverhang ([^:]+): "(\d+) (\d+) (\d+) (\d+)"', line)
        if m:
            overhang[m.group(1)] = [int(v) for v in m.groups()[1:]]
        m = re.match(r'\*DefaultResolution: (\d+)', line)
        if m:
            res = int(m.group(1))
        if line.startswith('*cnivecBorderlessCover: "True"'):
            cover = True
    for k, s in sizes.items():
        s['area'] = area.get(k, [0, 0, s['w'], s['h']])
        s['visible'] = visible_area(s, printarea.get(k), overhang.get(k), res, cover)
    qualities = re.findall(r'^\*cupsPrintQuality (\w+)/', text, re.M)
    return {'sizes': sizes, 'media': media, 'default_media': default_media, 'qualities': qualities}


def visible_area(size, printarea, overhang, res, cover=False):
    """Part of a borderless page that lands on the paper, in points.

    The driver enlarges the page to the printer's borderless print area
    (keeping the aspect ratio, centred; filling it completely when the PPD
    says cnivecBorderlessCover), and the printer places that area
    past the paper edges by its overhang (top, left, bottom, right, in
    1/100 mm; e.g. 2 / 2.8 / 5 / 2.8 mm on a G3010).  Whatever falls
    outside the paper is lost, mostly at the bottom."""
    if not printarea or not overhang:
        return None
    pw, ph = size['w'] / 72 * res, size['h'] / 72 * res          # paper in printer pixels
    PW, PH = printarea
    s = max(PW / pw, PH / ph) if cover else min(PW / pw, PH / ph)
    ofs_x, ofs_y = (PW - round(pw * s)) / 2, (PH - round(ph * s)) / 2
    top, left = overhang[0] / 2540 * res, overhang[1] / 2540 * res
    k = 72 / res / s                                               # printer px -> page points
    return QRectF((left - ofs_x) * k, (top - ofs_y) * k, pw * k, ph * k)


MM = 72 / 25.4
# picture past the expected paper edge (mm): less = less zoom, more = more
# tolerance for a sheet that is not exactly where the printer expects it
EXTENSIONS = [('Small (least zoom)', 0.8), ('Normal', 1.5), ('Large (safest)', 2.5)]
CONFIG = os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')), 'canon-ivec',
                      'photo-print.json')


def load_config():
    try:
        return json.load(open(CONFIG))
    except (OSError, ValueError):
        return {}


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    json.dump(cfg, open(CONFIG, 'w'), indent=1)


def paper_to_page(size, x_mm, y_mm, shift_mm=0.0):
    """Where a point on the paper (mm from its top-left corner) is on the page."""
    v = size['visible']
    return QPointF(v.x() + (x_mm + shift_mm) * MM * v.width() / size['w'],
                   v.y() + y_mm * MM * v.height() / size['h'])


def on_paper(size, shift_mm=0.0):
    """Page rectangle that lands on the paper, given the sheet's sideways shift."""
    v = size['visible']
    return v.translated(shift_mm * MM * v.width() / size['w'], 0)


def base_sizes(sizes):
    """Paper choices without the .bl duplicates; photo sizes first."""
    names = [n for n in sizes if not n.endswith('.bl')]
    def key(n):
        s = sizes[n]
        return (0 if max(s['w'], s['h']) <= 600 else 1, s['w'] * s['h'])
    return sorted(names, key=key)


# ---- layout and rendering ----

def load_image(path):
    r = QImageReader(path)
    r.setAutoTransform(True)        # respect EXIF orientation from phones and cameras
    img = r.read()
    return img if not img.isNull() else None


@lru_cache(maxsize=64)
def preview_source(path):
    """Downscaled copy for the on-screen preview."""
    img = load_image(path)
    if img is not None and max(img.width(), img.height()) > 1400:
        img = img.scaled(1400, 1400, Qt.KeepAspectRatio, Qt.SmoothTransformation)
    return img


ADJUST_KEYS = ('brightness', 'contrast', 'saturation', 'cyan', 'magenta', 'yellow')


def adjust(img, a):
    """Colour adjustment, sliders -50..50.  Cyan/magenta/yellow work like a
    printer's colour balance: more cyan takes red out, more magenta takes
    green out, more yellow takes blue out."""
    if img is None or np is None or not a or not any(a.values()):
        return img
    img = img.convertToFormat(QImage.Format_RGB888)
    w, h, bpl = img.width(), img.height(), img.bytesPerLine()
    arr = np.frombuffer(img.constBits(), np.uint8, count=bpl * h).reshape(h, bpl)[:, :w * 3]
    arr = arr.reshape(h, w, 3).astype(np.float32)
    for ch, key in enumerate(('cyan', 'magenta', 'yellow')):
        arr[..., ch] *= 1.0 - a[key] / 200.0
    if a['saturation']:
        lum = arr @ np.array([0.2126, 0.7152, 0.0722], np.float32)
        arr = lum[..., None] + (arr - lum[..., None]) * (1.0 + a['saturation'] / 50.0)
    if a['contrast']:
        arr = (arr - 128.0) * (1.0 + a['contrast'] / 50.0) + 128.0
    if a['brightness']:
        arr += a['brightness'] * 1.5
    out = np.ascontiguousarray(np.clip(arr, 0, 255).astype(np.uint8))
    return QImage(out.data, w, h, 3 * w, QImage.Format_RGB888).copy()


def cells(size, borderless, count, cols, rows, geo=None):
    """Photo rectangles (points, top-left origin) on a portrait sheet.
    geo: {'shift': mm the sheet sits right of centre, 'bleed': mm}."""
    w, h = size['w'], size['h']
    if borderless and size.get('visible') is not None and count == 1:
        # Lay the photo out for what reaches the paper (the overhang is
        # uneven: 2 mm top, 5 mm bottom on a G3010), at the sheet's measured
        # sideways position, plus the chosen extension.
        geo = geo or {}
        b = geo.get('bleed', 1.5) * MM
        return [on_paper(size, geo.get('shift', 0.0)).adjusted(-b, -b, b, b)]
    if borderless:
        x0, y0, x1, y1 = 0.0, 0.0, w, h
    else:
        l, b, r, t = size['area']
        x0, y0, x1, y1 = l, h - t, r, h - b
    gap = 0.0 if count == 1 else GAP
    cw = (x1 - x0 - gap * (cols - 1)) / cols
    ch = (y1 - y0 - gap * (rows - 1)) / rows
    return [QRectF(x0 + c * (cw + gap), y0 + r * (ch + gap), cw, ch) for r in range(rows) for c in range(cols)]


def draw_photo(p, img, rect, fill):
    """Draw img into rect, rotating it when that fits the cell better."""
    landscape_img = img.width() > img.height()
    landscape_cell = rect.width() > rect.height()
    p.save()
    if landscape_img != landscape_cell:
        p.translate(rect.center())
        p.rotate(90)
        rect = QRectF(-rect.height() / 2, -rect.width() / 2, rect.height(), rect.width())
    sx, sy = rect.width() / img.width(), rect.height() / img.height()
    s = max(sx, sy) if fill else min(sx, sy)
    dw, dh = img.width() * s, img.height() * s
    target = QRectF(rect.center().x() - dw / 2, rect.center().y() - dh / 2, dw, dh)
    p.setClipRect(rect)
    p.drawImage(target, img)
    p.restore()


def render_sheets(paint_page, photos, size, borderless, layout, fill, copies_each=1, only=None,
                  adj=None, preview=False, geo=None):
    """Calls paint_page(index) -> QPainter for each sheet (or just sheet
    `only`) and draws it.  Returns the number of sheets."""
    count, cols, rows = layout
    seq = [ph for ph in photos for _ in range(copies_each)]
    pages = [seq[i:i + count] for i in range(0, len(seq), count)]
    for i, page in enumerate(pages):
        if only is not None and i != only:
            continue
        p = paint_page(i)
        for img_path, rect in zip(page, cells(size, borderless, count, cols, rows, geo)):
            img = adjust(preview_source(img_path) if preview else load_image(img_path), adj)
            if img:
                draw_photo(p, img, rect, fill)
    return len(pages)


def write_pdf(path, photos, size, borderless, layout, fill, copies_each, adj=None, geo=None):
    pdf = QPdfWriter(path)
    pdf.setResolution(300)
    pdf.setPageLayout(QPageLayout(QPageSize(QSizeF(size['w'], size['h']), QPageSize.Point, 'photo'),
                                  QPageLayout.Portrait, QMarginsF(0, 0, 0, 0)))
    painter = QPainter()
    scale = 300 / 72.0

    def page(i):
        if i == 0:
            painter.begin(pdf)
        else:
            pdf.newPage()
        painter.resetTransform()
        painter.scale(scale, scale)
        return painter

    n = render_sheets(page, photos, size, borderless, layout, fill, copies_each, adj=adj, geo=geo)
    if painter.isActive():
        painter.end()
    return n


def preview_image(photos, size, borderless, layout, fill, copies_each, page_no, max_px, adj=None, geo=None):
    scale = max_px / max(size['w'], size['h'])
    img = QImage(int(size['w'] * scale), int(size['h'] * scale), QImage.Format_RGB32)
    img.fill(QColor('white'))
    q = QPainter(img)
    q.setRenderHint(QPainter.SmoothPixmapTransform)
    q.scale(scale, scale)
    pages = render_sheets(lambda i: q, photos, size, borderless, layout, fill, copies_each, only=page_no,
                          adj=adj, preview=True, geo=geo)
    if not borderless:   # show the unprintable margin
        q.setPen(QColor('#d0d0d0'))
        l, b, r, t = size['area']
        q.drawRect(QRectF(l, size['h'] - t, r - l, t - b))
    q.end()
    v = on_paper(size, (geo or {}).get('shift', 0.0)) if size.get('visible') is not None else None
    if borderless and v is not None:
        # show the sheet as it comes out: only what lands on the paper
        img = img.copy(int(v.x() * scale), int(v.y() * scale), int(v.width() * scale), int(v.height() * scale))
    return img, pages


def write_alignment_pdf(path, size):
    """Borderless test sheet: numbered ticks just inside and past both side
    edges.  The last tick still on the paper on each side tells where the
    sheet sits."""
    pdf = QPdfWriter(path)
    pdf.setResolution(300)
    pdf.setPageLayout(QPageLayout(QPageSize(QSizeF(size['w'], size['h']), QPageSize.Point, 'align'),
                                  QPageLayout.Portrait, QMarginsF(0, 0, 0, 0)))
    p = QPainter(pdf)
    p.scale(300 / 72.0, 300 / 72.0)
    paper_w = size['w'] / MM
    p.setPen(QPen(QColor('black'), 0.35 * MM))
    font = QFont('Sans')
    font.setPixelSize(8)          # painter units are points here
    p.setFont(font)
    offsets = [x / 2 for x in range(-6, 7)]          # -3.0 .. +3.0 mm past the expected edge
    top = 22.0
    for i, off in enumerate(offsets):
        y0, y1 = top + i * 7.0, top + i * 7.0 + 5.0
        for x_mm in (-off, paper_w + off):           # left tick, right tick
            a, b = paper_to_page(size, x_mm, y0), paper_to_page(size, x_mm, y1)
            p.drawLine(a, b)
        c = paper_to_page(size, paper_w / 2, y1)
        p.drawText(QRectF(c.x() - 30, c.y() - 12, 60, 12), Qt.AlignCenter, f'{off:+.1f}')
    title = QFont('Sans')
    title.setPixelSize(9)
    title.setBold(True)
    p.setFont(title)
    t = paper_to_page(size, paper_w / 2, 7)
    p.drawText(QRectF(t.x() - 120, t.y() - 8, 240, 30), Qt.AlignHCenter | Qt.AlignTop,
               'Borderless alignment\nlast line on the paper: left / right')
    p.end()


class AlignDialog(QDialog):
    def __init__(self, parent, queue):
        super().__init__(parent)
        self.setWindowTitle('Borderless alignment')
        lay = QVBoxLayout(self)
        lay.addWidget(QLabel(
            '1. Load one sheet of 4x6 photo paper (plain paper works too) and press "Print test sheet".\n'
            '2. Each row has a short line near the left and the right edge, labelled -3.0 to +3.0.\n'
            '   On each side, find the LAST row (going down) whose line is still on the paper.\n'
            '3. Enter those two numbers and press OK.'))
        test = QPushButton('Print test sheet')
        test.clicked.connect(lambda: parent.print_alignment())
        lay.addWidget(test)
        form = QFormLayout()
        self.left, self.right = QDoubleSpinBox(), QDoubleSpinBox()
        for sb in (self.left, self.right):
            sb.setRange(-3.0, 3.0)
            sb.setSingleStep(0.5)
            sb.setDecimals(1)
        form.addRow('Left edge: last visible row', self.left)
        form.addRow('Right edge: last visible row', self.right)
        lay.addLayout(form)
        box = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        box.accepted.connect(self.accept)
        box.rejected.connect(self.reject)
        lay.addWidget(box)

    def shift(self):
        # paper sits d mm right: right edge shows up to +d, left edge only up to -d
        return (self.right.value() - self.left.value()) / 2


# ---- window ----

class PhotoPrint(QMainWindow):
    def __init__(self, files):
        super().__init__()
        self.setWindowTitle('Canon Photo Print')
        self.setWindowIcon(QIcon.fromTheme('document-print'))
        self.setAcceptDrops(True)
        self.info = None
        self.page_no = 0

        root = QWidget()
        lay = QHBoxLayout(root)

        left = QVBoxLayout()
        self.list = QListWidget()
        self.list.setIconSize(QSize(96, 96))
        self.list.setMinimumWidth(240)
        left.addWidget(QLabel('Photos (drag files here)'))
        left.addWidget(self.list)
        row = QHBoxLayout()
        add, rem = QPushButton('Add photos...'), QPushButton('Remove')
        add.clicked.connect(self.add_dialog)
        rem.clicked.connect(self.remove_selected)
        row.addWidget(add)
        row.addWidget(rem)
        left.addLayout(row)
        lay.addLayout(left)

        mid = QVBoxLayout()
        self.preview = QLabel()
        self.preview.setAlignment(Qt.AlignCenter)
        self.preview.setMinimumSize(420, 520)
        self.preview.setStyleSheet('background: #5f6368; border-radius: 6px;')
        mid.addWidget(self.preview, 1)
        nav = QHBoxLayout()
        self.prev_btn, self.next_btn = QPushButton('<'), QPushButton('>')
        self.page_lbl = QLabel()
        self.prev_btn.clicked.connect(lambda: self.turn(-1))
        self.next_btn.clicked.connect(lambda: self.turn(1))
        nav.addWidget(self.prev_btn)
        nav.addWidget(self.page_lbl, 1, Qt.AlignCenter)
        nav.addWidget(self.next_btn)
        mid.addLayout(nav)
        lay.addLayout(mid, 1)

        form = QFormLayout()
        self.printer = QComboBox()
        self.paper = QComboBox()
        self.borderless = QCheckBox('Borderless')
        self.layout_box = QComboBox()
        for count, cols, rows in LAYOUTS:
            self.layout_box.addItem('1 photo per sheet' if count == 1 else f'{count} photos per sheet ({cols} x {rows})',
                                    (count, cols, rows))
        self.fill = QComboBox()
        self.fill.addItem('Fill (crop edges)', True)
        self.fill.addItem('Fit whole photo', False)
        self.media = QComboBox()
        self.quality = QComboBox()
        self.each = QSpinBox()
        self.each.setRange(1, 99)
        self.copies = QSpinBox()
        self.copies.setRange(1, 99)
        form.addRow('Printer', self.printer)
        form.addRow('Paper size', self.paper)
        form.addRow('', self.borderless)
        form.addRow('Layout', self.layout_box)
        form.addRow('Photo', self.fill)
        form.addRow('Paper type', self.media)
        form.addRow('Quality', self.quality)
        form.addRow('Prints of each photo', self.each)
        form.addRow('Copies of the whole job', self.copies)
        border = QGroupBox('Borderless')
        bform = QFormLayout(border)
        self.extension = QComboBox()
        for label, mm in EXTENSIONS:
            self.extension.addItem(label, mm)
        self.extension.setCurrentIndex(1)
        self.shift = QDoubleSpinBox()
        self.shift.setRange(-4.0, 4.0)
        self.shift.setSingleStep(0.5)
        self.shift.setDecimals(1)
        self.shift.setSuffix(' mm')
        self.shift.setToolTip('How far the sheet sits right (+) or left (-) of where the printer expects it')
        align = QPushButton('Alignment test...')
        align.clicked.connect(self.alignment)
        bform.addRow('Extension', self.extension)
        bform.addRow('Paper position', self.shift)
        bform.addRow('', align)
        self.extension.currentIndexChanged.connect(self.geo_changed)
        self.shift.valueChanged.connect(self.geo_changed)

        self.sliders = {}
        color = QGroupBox('Color')
        cform = QFormLayout(color)
        labels = {'brightness': 'Brightness', 'contrast': 'Contrast', 'saturation': 'Saturation',
                  'cyan': 'Red  <>  Cyan', 'magenta': 'Green  <>  Magenta', 'yellow': 'Blue  <>  Yellow'}
        self.adj_timer = QTimer(self, singleShot=True, interval=120)
        self.adj_timer.timeout.connect(self.refresh)
        for key in ADJUST_KEYS:
            sl = QSlider(Qt.Horizontal)
            sl.setRange(-50, 50)
            sl.setTickInterval(25)
            sl.setTickPosition(QSlider.TicksBelow)
            sl.valueChanged.connect(lambda _v: self.adj_timer.start())
            sl.setEnabled(np is not None)
            cform.addRow(labels[key], sl)
            self.sliders[key] = sl
        reset = QPushButton('Reset colors')
        reset.clicked.connect(lambda: [sl.setValue(0) for sl in self.sliders.values()])
        reset.setEnabled(np is not None)
        cform.addRow('', reset)
        if np is None:
            cform.addRow(QLabel('Install numpy (python-numpy) for color adjustment.'))
        self.print_btn = QPushButton('Print')
        self.print_btn.setDefault(True)
        self.print_btn.setMinimumHeight(40)
        self.print_btn.clicked.connect(self.do_print)
        side = QVBoxLayout()
        side.addLayout(form)
        side.addWidget(border)
        side.addWidget(color)
        side.addStretch(1)
        self.status = QLabel()
        self.status.setWordWrap(True)
        side.addWidget(self.status)
        side.addWidget(self.print_btn)
        lay.addLayout(side)
        self.setCentralWidget(root)

        queues, default = printers()
        self.printer.addItems(queues)
        if default in queues:
            self.printer.setCurrentText(default)
        self.printer.currentTextChanged.connect(self.load_printer)
        for w in (self.paper, self.layout_box, self.fill, self.media, self.quality):
            w.currentIndexChanged.connect(self.refresh)
        self.borderless.toggled.connect(self.borderless_changed)
        self.each.valueChanged.connect(self.refresh)
        self.paper.currentIndexChanged.connect(self.paper_changed)
        self.layout_box.currentIndexChanged.connect(self.paper_changed)
        self.load_printer(self.printer.currentText())
        self.add_files(files)

    # photos
    def add_files(self, files):
        for f in files:
            if os.path.isfile(f) and load_image(f) is not None:
                item = QListWidgetItem(QIcon(QPixmap.fromImage(load_image(f).scaled(
                    96, 96, Qt.KeepAspectRatio, Qt.SmoothTransformation))), os.path.basename(f))
                item.setData(Qt.UserRole, f)
                self.list.addItem(item)
        self.refresh()

    def photos(self):
        return [self.list.item(i).data(Qt.UserRole) for i in range(self.list.count())]

    def add_dialog(self):
        files, _ = QFileDialog.getOpenFileNames(self, 'Add photos', os.path.expanduser('~/Pictures'), IMAGE_FILTER)
        self.add_files(files)

    def remove_selected(self):
        for item in self.list.selectedItems():
            self.list.takeItem(self.list.row(item))
        self.refresh()

    def dragEnterEvent(self, e):
        if e.mimeData().hasUrls():
            e.acceptProposedAction()

    def dropEvent(self, e):
        self.add_files([u.toLocalFile() for u in e.mimeData().urls()])

    # printer settings
    def load_printer(self, queue):
        self.info = printer_ppd(queue) if queue else None
        for w in (self.paper, self.media, self.quality):
            w.blockSignals(True)
            w.clear()
        if not self.info or not self.info['sizes']:
            self.status.setText('Could not read the printer settings. Is the printer set up (canonctl setup)?')
        else:
            sizes = self.info['sizes']
            for n in base_sizes(sizes):
                label = re.sub(r'\s*\[.*\]', '', sizes[n]['label']).replace("'", '"')
                self.paper.addItem(label, n)
            i = self.paper.findData('4x6')
            self.paper.setCurrentIndex(max(i, 0))
            for name, label in self.info['media']:
                self.media.addItem(label, name)
            for q in self.info['qualities'] or ['Normal']:
                self.quality.addItem(q, q)
            self.quality.setCurrentText('High' if 'High' in self.info['qualities'] else self.quality.itemText(0))
            self.status.setText('')
        for w in (self.paper, self.media, self.quality):
            w.blockSignals(False)
        saved = load_config().get(queue, {})
        self._loading = True
        if hasattr(self, 'extension'):
            self.extension.setCurrentIndex(saved.get('extension', 1))
            self.shift.setValue(saved.get('shift', 0.0))
        self._loading = False
        self.paper_changed()

    def size(self):
        if not self.info:
            return None
        name = self.paper.currentData()
        if self.borderless.isChecked() and f'{name}.bl' in self.info['sizes']:
            name = f'{name}.bl'
        return self.info['sizes'].get(name)

    def paper_changed(self):
        if not self.info:
            return self.refresh()
        name = self.paper.currentData()
        can_bl = bool(name) and f'{name}.bl' in self.info['sizes']
        single = (self.layout_box.currentData() or (1,))[0] == 1
        self.borderless.blockSignals(True)
        self.borderless.setEnabled(can_bl and single)
        self.borderless.setChecked(can_bl and single and self.borderless.isChecked() or
                                   (can_bl and single and name in ('4x6', '5x7in', 'l', 'Postcard', '8x10')))
        self.borderless.blockSignals(False)
        self.borderless_changed()

    def borderless_changed(self):
        # Canon only allows borderless on photo papers: switch to one
        if self.info and (self.borderless.isChecked() or (self.paper.currentData() or '') in ('4x6', '5x7in', 'l')):
            cur = self.media.currentData() or ''
            if not any(h in cur.lower() for h in PHOTO_HINT):
                for i in range(self.media.count()):
                    if any(h in (self.media.itemData(i) or '').lower() for h in PHOTO_HINT[:2]):
                        self.media.setCurrentIndex(i)
                        break
        self.refresh()

    def geometry(self):
        return {'bleed': self.extension.currentData(), 'shift': self.shift.value()}

    def geo_changed(self, *_):
        q = self.printer.currentText()
        if q and not getattr(self, '_loading', False):
            cfg = load_config()
            cfg[q] = {'extension': self.extension.currentIndex(), 'shift': self.shift.value()}
            save_config(cfg)
        self.refresh()

    def alignment(self):
        dlg = AlignDialog(self, self.printer.currentText())
        if dlg.exec() == QDialog.Accepted:
            self.shift.setValue(dlg.shift())
            self.status.setText(f'Paper position set to {dlg.shift():+.1f} mm for {self.printer.currentText()}.')

    def print_alignment(self):
        size = self.info['sizes'].get('4x6.bl') if self.info else None
        if not size or size.get('visible') is None:
            QMessageBox.information(self, 'Alignment', 'This printer has no borderless 4x6 size.')
            return
        fd, pdf = tempfile.mkstemp(suffix='.pdf', prefix='canon-align-')
        os.close(fd)
        try:
            write_alignment_pdf(pdf, size)
            media = next((self.media.itemData(i) for i in range(self.media.count())
                          if any(h in (self.media.itemData(i) or '').lower() for h in PHOTO_HINT[:2])), None)
            cmd = ['lp', '-d', self.printer.currentText(), '-t', 'Borderless alignment', '-o', 'PageSize=4x6.bl']
            if media:
                cmd += ['-o', f'MediaType={media}']
            subprocess.run(cmd + [pdf], check=True, capture_output=True)
        finally:
            os.unlink(pdf)

    def adjustments(self):
        return {k: sl.value() for k, sl in self.sliders.items()}

    # preview
    def refresh(self, *_):
        size, photos = self.size(), self.photos()
        if not size or not photos:
            self.preview.setText('Add photos to see a preview' if size else '')
            self.page_lbl.setText('')
            self.print_btn.setEnabled(False)
            return
        img, pages = preview_image(photos, size, self.size()['name'].endswith('.bl'),
                                   self.layout_box.currentData(), self.fill.currentData(), self.each.value(),
                                   min(self.page_no, 10 ** 6), 900, self.adjustments(), self.geometry())
        if self.page_no >= pages:
            self.page_no = pages - 1
            return self.refresh()
        pix = QPixmap.fromImage(img).scaled(self.preview.size() - QSize(24, 24), Qt.KeepAspectRatio,
                                            Qt.SmoothTransformation)
        self.preview.setPixmap(pix)
        self.page_lbl.setText(f'Sheet {self.page_no + 1} of {pages}')
        self.prev_btn.setEnabled(self.page_no > 0)
        self.next_btn.setEnabled(self.page_no < pages - 1)
        self.print_btn.setEnabled(True)
        self.print_btn.setText(f'Print {pages * self.copies.value()} sheet' + ('s' if pages * self.copies.value() > 1 else ''))

    def turn(self, d):
        self.page_no = max(0, self.page_no + d)
        self.refresh()

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.refresh()

    # print
    def do_print(self):
        size, photos = self.size(), self.photos()
        queue = self.printer.currentText()
        fd, pdf = tempfile.mkstemp(suffix='.pdf', prefix='canon-photo-')
        os.close(fd)
        try:
            pages = write_pdf(pdf, photos, size, size['name'].endswith('.bl'), self.layout_box.currentData(),
                              self.fill.currentData(), self.each.value(), self.adjustments(), self.geometry())
            cmd = ['lp', '-d', queue, '-t', f'Photos ({len(photos)})', '-n', str(self.copies.value()),
                   '-o', f'PageSize={size["name"]}', '-o', 'ColorModel=RGB', '-o', 'print-color-mode=color']
            if self.media.currentData():
                cmd += ['-o', f'MediaType={self.media.currentData()}']
            if self.quality.currentData() and self.quality.currentData() != 'Normal':
                cmd += ['-o', f'cupsPrintQuality={self.quality.currentData()}']
            r = subprocess.run(cmd + [pdf], capture_output=True, text=True)
            if r.returncode:
                raise RuntimeError(r.stderr.strip())
            self.status.setText(f'Sent {pages} sheet(s) to {queue}. Load {self.media.currentText()} '
                                f'({self.paper.currentText()}) in the rear tray.')
        except Exception as e:
            QMessageBox.critical(self, 'Print failed', str(e))
        finally:
            # CUPS has its own copy once lp returns
            os.unlink(pdf)


def main():
    if '--pdf' in sys.argv:
        # canon-photo-print --pdf OUT QUEUE PAGESIZE LAYOUT(1|2|4|6|9) PHOTO... (for tests)
        i = sys.argv.index('--pdf')
        out, queue, page, count = sys.argv[i + 1:i + 5]
        if count == 'align':
            app = QApplication.instance() or QApplication(sys.argv[:1])
            write_alignment_pdf(out, printer_ppd(queue)['sizes'][page])
            print(f'alignment sheet -> {out}')
            return 0
        photos = sys.argv[i + 5:]
        app = QApplication.instance() or QApplication(sys.argv[:1])
        info = printer_ppd(queue)
        layout = next(l for l in LAYOUTS if l[0] == int(count))
        n = write_pdf(out, photos, info['sizes'][page], page.endswith('.bl'), layout, True, 1)
        print(f'{n} sheet(s) -> {out}')
        return 0
    app = QApplication(sys.argv)
    app.setApplicationName('Canon Photo Print')
    app.setDesktopFileName('canon-photo-print')
    w = PhotoPrint([a for a in sys.argv[1:] if not a.startswith('-')])
    w.resize(1180, 720)
    w.show()
    return app.exec()


if __name__ == '__main__':
    sys.exit(main())
